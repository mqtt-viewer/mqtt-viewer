{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "strictNullChecks": true,
    "ignoreDeprecations": "5.0",
    "baseUrl": ".",
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    /**
     * Vite does the emitting, so tsc is typecheck-only. That lets
     * release-notes.ts import ./changelog.ts by its real filename, which is
     * what scripts/release-notes.mjs needs to load it in plain Node.
     */
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "@/*": ["src/*"],
      "bindings/*": ["./bindings/*"]
    }
  },
  "include": [
    "src/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.js",
    "src/**/*.svelte",
  ],
  "exclude": ["tsconfig.json", "src/components/CodeEditor/ace/**/*"],
  "references": [
    {
      "path": "./tsconfig.node.json"
    }
  ]
}
