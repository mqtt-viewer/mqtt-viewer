{
  "$schema": "../../../../../design-system/component-spec.schema.json",
  "name": "SelectedTopicPanel",
  "tier": "view",
  "description": "Storybook coverage for SelectedTopicPanel.",
  "status": "story-only",
  "figma": {
    "fileKey": "",
    "nodeId": "",
    "url": "",
    "lastSyncedHash": null,
    "lastSyncedAt": null
  },
  "props": [
    {
      "name": "connectionId",
      "type": "number",
      "required": true
    },
    {
      "name": "selectedTopicStore",
      "type": "store",
      "required": true
    },
    {
      "name": "firstConnectedAtMs",
      "type": "number",
      "required": true
    },
    {
      "name": "mqttVersion",
      "type": "enum",
      "required": true,
      "options": [
        "3",
        "5"
      ]
    },
    {
      "name": "exportTopicMessages",
      "type": "function",
      "required": true,
      "default": "> Promise<void>"
    },
    {
      "name": "copyTopicPath",
      "type": "function",
      "required": true
    },
    {
      "name": "onClearRetained",
      "type": "function",
      "required": true,
      "description": "Raises a clear request; DataView confirms it and performs the clear."
    },
    {
      "name": "onClearRetainedBelow",
      "type": "function",
      "required": true,
      "description": "Raises a bulk clear request for topics below the selected one."
    },
    {
      "name": "openChartWindow",
      "type": "function",
      "required": false,
      "default": null
    },
    {
      "name": "dockMode",
      "type": "enum",
      "required": false,
      "options": [
        "right",
        "bottom",
        "window"
      ],
      "default": "right"
    },
    {
      "name": "onSetDockMode",
      "type": "function",
      "required": false,
      "default": null
    },
    {
      "name": "showCloseButton",
      "type": "boolean",
      "required": false,
      "default": true
    },
    {
      "name": "headerDraggable",
      "type": "boolean",
      "required": false,
      "default": false
    },
    {
      "name": "headerLeftInset",
      "type": "number",
      "required": false,
      "default": 0
    },
    {
      "name": "viewState",
      "type": "store",
      "required": false
    },
    {
      "name": "isPinned",
      "type": "boolean",
      "required": false,
      "default": false,
      "description": "Whether the selected topic is pinned. Fills the header pin button and switches the menu item to Unpin topic."
    },
    {
      "name": "onTogglePin",
      "type": "function",
      "required": false,
      "default": "> void"
    }
  ],
  "tokens": [
    "secondary",
    "secondary-text",
    "elevation-1",
    "primary"
  ],
  "dependencies": [],
  "notes": "Figma is not linked yet; this story uses local Storybook fixtures."
}
